<?xml version="1.0" encoding="utf-8"?>
<!-- Sovelluksen värit Material 3 -rooleittain. Näppäimistö (KeyboardTheme) ja
     asetussivun teema (themes.xml) käyttävät näitä samoja määrityksiä. -->
<resources>
    <color name="ic_launcher_background">#1B6EF3</color>

    <!-- Vaalea teema. Kontrastit WCAG AAA -tasoa: teksti- ja vihjevärit
         vähintään 7:1 omilla pinnoillaan, korostusparit samoin. -->
    <color name="vaalea_tausta">#E9EBEF</color>
    <color name="vaalea_nappain">#FFFFFF</color>
    <color name="vaalea_erikoisnappain">#D4D8E0</color>
    <color name="vaalea_painettu">#BFC6D1</color>
    <color name="vaalea_teksti">#1B1D22</color>
    <color name="vaalea_vihje">#444A53</color>
    <color name="vaalea_korostus">#0946AC</color>
    <color name="vaalea_korostusteksti">#FFFFFF</color>
    <color name="vaalea_kortti">#FFFFFF</color>

    <!-- Tumma teema -->
    <color name="tumma_tausta">#14161B</color>
    <color name="tumma_nappain">#2A2E37</color>
    <color name="tumma_erikoisnappain">#20232B</color>
    <color name="tumma_painettu">#3D4350</color>
    <color name="tumma_teksti">#E8EAF0</color>
    <color name="tumma_vihje">#BAC0CC</color>
    <color name="tumma_korostus">#A9C7FF</color>
    <color name="tumma_korostusteksti">#122E52</color>
    <color name="tumma_kortti">#333944</color>

    <!-- Musta teema: OLED-näytöllä tausta ei kuluta virtaa -->
    <color name="musta_tausta">#000000</color>
    <color name="musta_nappain">#1C1E24</color>
    <color name="musta_erikoisnappain">#101216</color>
    <color name="musta_painettu">#333842</color>
    <color name="musta_teksti">#ECEEF4</color>
    <color name="musta_vihje">#BAC0CC</color>
    <color name="musta_korostus">#A9C7FF</color>
    <color name="musta_korostusteksti">#122E52</color>
    <!-- Asetussivun Compose-teeman staattiset roolit (Android 8–11, joilla ei
         ole Material You -palettia). Sävyt CIELAB-vaaleuksina samaan tapaan
         kuin dynaamisessa paletissa, ARKin sinisellä (sävykulma 265):
         teksti ja pohja aina 60 vaaleusasteen päässä, mikä takaa WCAG AAA:n 7:1. -->
    <color name="vaalea_pinta">#F7F9FD</color> <!-- tone 98 -->
    <color name="vaalea_kortti_pinta">#E9EEF5</color> <!-- tone 94 -->
    <color name="vaalea_korostuspohja">#D0E4FF</color> <!-- tone 90 -->
    <color name="vaalea_korostuspohjateksti">#014A75</color> <!-- tone 30 -->
    <color name="vaalea_toissijainen_pohja">#D4E4F9</color> <!-- tone 90 -->
    <color name="vaalea_toissijainen_teksti">#37485C</color> <!-- tone 30 -->
    <color name="vaalea_tertiaari_pohja">#F8D9F9</color> <!-- tone 90, sävykulma 325 -->
    <color name="vaalea_tertiaari_teksti">#603962</color> <!-- tone 30 -->
    <color name="vaalea_aariviiva">#6F7884</color> <!-- tone 50 -->
    <color name="tumma_pinta">#111316</color> <!-- tone 6 -->
    <color name="tumma_kortti_pinta">#1C2025</color> <!-- tone 12 -->
    <color name="tumma_korostuspohja">#014A75</color> <!-- tone 30 -->
    <color name="tumma_korostuspohjateksti">#D0E4FF</color> <!-- tone 90 -->
    <color name="tumma_toissijainen_pohja">#37485C</color> <!-- tone 30 -->
    <color name="tumma_toissijainen_teksti">#D7E4F5</color> <!-- tone 90 -->
    <color name="tumma_tertiaari_pohja">#603962</color> <!-- tone 30 -->
    <color name="tumma_tertiaari_teksti">#F8D9F9</color> <!-- tone 90 -->
    <color name="tumma_aariviiva">#88929E</color> <!-- tone 60 -->
    <!-- Loput M3-roolit samasta sävystä, jotta dialogit ja neutraalit pinnat
         eivät jää kirjaston violetille oletukselle Android 8–11:ssä. -->
    <color name="vaalea_pinta_matalin">#FFFFFF</color> <!-- tone 100 -->
    <color name="vaalea_pinta_matala">#F0F4F9</color> <!-- tone 96 -->
    <color name="vaalea_pinta_korkea">#E4E9F0</color> <!-- tone 92 -->
    <color name="vaalea_pinta_korkein">#DDE3EC</color> <!-- tone 90 -->
    <color name="vaalea_toissijainen">#4B6078</color> <!-- tone 40 -->
    <color name="vaalea_tertiaari">#745475</color> <!-- tone 40, sävykulma 325 -->
    <color name="vaalea_aariviiva_vaalea">#BDC7D5</color> <!-- tone 80 -->
    <color name="tumma_pinta_matalin">#0C0E12</color> <!-- tone 4 -->
    <color name="tumma_pinta_matala">#191C1F</color> <!-- tone 10 -->
    <color name="tumma_pinta_korkea">#262A2F</color> <!-- tone 17 -->
    <color name="tumma_pinta_korkein">#30353C</color> <!-- tone 22 -->
    <color name="tumma_toissijainen">#B3C8E4</color> <!-- tone 80 -->
    <color name="tumma_tertiaari">#E0BBE0</color> <!-- tone 80 -->
    <color name="tumma_aariviiva_tumma">#3F4853</color> <!-- tone 30 -->
</resources>
